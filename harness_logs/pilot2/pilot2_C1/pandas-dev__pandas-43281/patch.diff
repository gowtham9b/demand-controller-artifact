diff --git a/pandas/core/ops/missing.py b/pandas/core/ops/missing.py
index ea62237655..61997881d0 100644
--- a/pandas/core/ops/missing.py
+++ b/pandas/core/ops/missing.py
@@ -117,6 +117,35 @@ def mask_zero_div_zero(x, y, result):
 
     if zmask.any():
 
+        if (
+            isinstance(x, np.ndarray)
+            and x.dtype.kind in "iuf"
+            and y.dtype.kind in "iuf"
+            and zmask.shape == result.shape
+            and zmask.sum() * 10 < zmask.size
+        ):
+            # sparse path: only evaluate at positions where y == 0
+            idx = zmask.nonzero()
+            xb = np.broadcast_to(x, zmask.shape)
+            yb = np.broadcast_to(y, zmask.shape)
+            xs = xb[idx]
+            neg = np.signbit(yb[idx])
+            with np.errstate(invalid="ignore"):
+                nan_s = xs == 0
+                neginf_s = (~neg & (xs < 0)) | (neg & (xs > 0))
+                posinf_s = (~neg & (xs > 0)) | (neg & (xs < 0))
+            if nan_s.any() or neginf_s.any() or posinf_s.any():
+                result = result.astype("float64", copy=False)
+                fill = np.zeros(xs.shape, dtype="float64")
+                # positions not matching any condition keep original values
+                keep = ~(nan_s | neginf_s | posinf_s)
+                fill[nan_s] = np.nan
+                fill[posinf_s] = np.inf
+                fill[neginf_s] = -np.inf
+                fill[keep] = result[tuple(i[keep] for i in idx)]
+                result[idx] = fill
+            return result
+
         # Flip sign if necessary for -0.0
         zneg_mask = zmask & np.signbit(y)
         zpos_mask = zmask & ~zneg_mask
