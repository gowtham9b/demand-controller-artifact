+                return np.concatenate([non_na, nas]).astype(np.intp, copy=False)
+            return np.concatenate([nas, non_na]).astype(np.intp, copy=False)
+        return super().argsort(
+            ascending=ascending, kind=kind, na_position=na_position, *args, **kwargs
+        )
