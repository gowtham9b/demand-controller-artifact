+    def argsort(
+        self,
+        ascending: bool = True,
+        kind: str = "quicksort",
+        na_position: str = "last",
+        *args,
+        **kwargs,
+    ) -> np.ndarray:
+        left = self._left
+        right = self._right
+        if (
+            ascending
+            and not args
+            and not kwargs
+            and isinstance(left, np.ndarray)
+            and left.dtype.kind in "iuf"
+            and isinstance(right, np.ndarray)
+            and right.dtype.kind in "iuf"
+            and not self.isna().any()
+        ):
+            # Intervals order by left, then right
+            return np.lexsort((right, left))
+        return super().argsort(
+            ascending=ascending,
+            kind=kind,
+            na_position=na_position,
+            *args,
+            **kwargs,
+        )
