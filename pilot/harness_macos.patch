diff --git a/swefficiency/harness/run_validation.py b/swefficiency/harness/run_validation.py
index 9b34f74..43857bd 100644
--- a/swefficiency/harness/run_validation.py
+++ b/swefficiency/harness/run_validation.py
@@ -335,6 +335,26 @@ def run_instance(
 
         logger.info(f"Container for {instance_id} started: {container.id}")
 
+        extra_ca = os.environ.get("SWEF_EXTRA_CA")
+        if extra_ca:
+            # Networks that intercept TLS (e.g. corporate proxies) need their root CA
+            # trusted inside the container for workloads and rebuilds that download.
+            # copy_to_container writes and deletes <src>.tar next to the source, so a
+            # shared source races between parallel workers; copy it per instance first.
+            # It also keeps the source file name: the destination is /tmp/extra-ca.pem.
+            local_ca = Path(log_dir / "extra-ca.pem")
+            shutil.copyfile(extra_ca, local_ca)
+            copy_to_container(container, local_ca, Path("/tmp/extra-ca.pem"))
+            container.exec_run(["bash", "-c", (
+                "cat /tmp/extra-ca.pem >> /etc/ssl/certs/ca-certificates.crt; "
+                "echo 'ca_certificate = /etc/ssl/certs/ca-certificates.crt' >> /etc/wgetrc; "
+                "printf '[global]\\ncert = /etc/ssl/certs/ca-certificates.crt\\n' > /etc/pip.conf; "
+                "for py in /opt/miniconda3/envs/*/bin/python /opt/miniconda3/bin/python; do "
+                "$py -c 'import certifi; print(certifi.where())' 2>/dev/null; "
+                "$py -c 'import pip._vendor.certifi as c; print(c.where())' 2>/dev/null; "
+                "done | sort -u | while read f; do cat /tmp/extra-ca.pem >> \"$f\"; done"
+            )], user="root")
+
         # Copy model prediction as patch file to container
         patch_file = Path(log_dir / "patch.diff")
 
